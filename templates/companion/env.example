# Her OWN accounts (never a shared 556 account). Copy to .env and fill in; Hermes starts a
# platform when its token is present. Values never leave this profile directory.
# Telegram: @BotFather -> /newbot -> token. Your numeric id: @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Your DM as her home channel (notifications, cron results, app mirror); same numeric id.
TELEGRAM_HOME_CHANNEL=
# Discord: Developer Portal -> Application -> Bot -> token; enable Message Content Intent.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
