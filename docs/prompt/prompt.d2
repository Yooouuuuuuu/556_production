direction: down

title: "556 Production — the prompt (0.7.9): one request, top to bottom, who writes each piece and how many copies it costs" {
  shape: text
  near: top-center
  style.font-size: 20
}

classes: {
  ours: {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
  }
  vendor: {
    style.fill: "#f3f3f3"
    style.stroke: "#999999"
    style.font-color: "#555555"
  }
  proposed: {
    style.stroke-dash: 4
    style.stroke: "#c2185b"
    style.font-color: "#c2185b"
  }
  cost: {
    shape: text
    style.font-size: 13
    style.font-color: "#6a1b9a"
  }
}

legend: |md
  **green** = ours (author, kokoro, psyche, 556d) · **grey** = Hermes vendor text, never edited · **dashed pink** = decided, not built

  copies = how many times the piece is in one request (history replays past rows exactly as sent)
| {near: top-left}

system: "1 · System prompt — one copy per request, byte-stable until her restart or a context compression (cached prefix)" {
  cost: "×1, cached" {class: cost}

  stable: "stable tier" {
    soul: "SOUL.md — her identity, first\n西: 2,871 chars, 4 sections today; 6 parts in the design" {class: ours}
    help: "Help guidance · 466 chars\n\"You run on Hermes Agent (by Nous Research)… docs URL…\"\nno switch" {class: vendor}
    finish: "Finishing the job · 769 chars\nagent.task_completion_guidance: false" {class: vendor}
    parallel: "Parallel tool calls · 618 chars\nagent.parallel_tool_call_guidance: false" {class: vendor}
    steer: "Mid-turn user steering · 724 chars\nno switch while tools are loaded" {class: vendor}
    env: "Environment hints · ~1,600 chars\nHost Windows, your home dir, her cwd, the Windows-shell paragraph\nno switch for a local backend" {class: vendor}
    probe: "Environment probe · one line (Python toolchain)\nagent.environment_probe: false" {class: vendor}
    profile: "Active profile line · \"Active Hermes profile: xi. This session reads and writes …\"\nno switch" {class: vendor}
    hint: "Platform hint · api_server 712 / telegram 617 chars\n\"assume plain text… MEDIA:/absolute/path…\"\nplatform_hints.<platform>: {replace: …}" {class: vendor}
    soul -> help -> finish -> parallel -> steer -> env -> probe -> profile -> hint
  }

  context: "context tier" {
    voice: "voice turns only: 556d's hands-free 說話風格 text as system_message\n(injected for that call, never cached)" {class: ours}
  }

  volatile: "volatile tier" {
    kokoro: "kokoro static block\nmemory rule (English today) + \"About <your term> …\" + people/你.md\n→ the slot for pinned groups" {class: ours}
    pinned: "pinned groups · ~1,000 chars\ntimeline (dated), influences, stances, refusals, where she stands with each person\nrendered from reserved tags" {class: proposed}
    stamp: "timestamp + trailer\n\"Conversation started: …\" (+ \"Today's date (as of the last context rebuild)\")\nModel: auto/556 · Provider: custom · Platform: api_server\nno switch" {class: vendor}
    kokoro -> pinned -> stamp
  }

  shim: "appended by 556d's shim (lane without native tools)\n\"You are a function calling AI model…\" · 1,086 chars + the two schemas\nkokoro_search, kokoro_forget — ours, reworded freely" {class: ours}

  filter: "shim filter: drop the vendor paragraphs that have no switch\n(help, environment, profile line, trailer); wrappers in zh-TW" {class: proposed}

  stable -> context -> volatile -> shim
  filter -> stable: "removes" {style.stroke-dash: 4; style.stroke: "#c2185b"}
}

history: "2 · History — every row in the window, replayed exactly as sent (api_content)" {
  cost: "×20+ rows (compression.protect_last_n: 20); each past user row still carries its memory block and its state block" {class: cost}
  urow: "past user row = typed text + <memory-context> + <her-state>\n西's newest: 1,147 chars = 9 typed + 685 memory + 422 state" {class: ours}
  arow: "past assistant row = her reply as stored\n(<think>…</think> pairs stripped before storage)" {class: ours}
}

last: "3 · The last user message — three pieces glued with blank lines" {
  cost: "×1 per turn — but every line here is paid again in each of the next 20+ requests" {class: cost}
  text: "the text: what you typed · or 【事件】 narrator cue · or another character's message with the speaker's name" {class: ours}
  memory: "<memory-context> (Hermes wrapper, kokoro text)\n[System note: recalled memory context, NOT new user input…]\nFacts (long-term) top 5 · Notes (recent, dated) top 5 · [archived: …]\n+ 現在跟你說話的是<name>… + people/<name>.md when another character talks" {class: ours}
  triggers: "keyword-triggered groups for names and places\n(the lorebook tier)" {class: proposed}
  state: "<her-state> (psyche)\n[System note: 【她現在】 is her own inner state… never quote it, never mention it or any numbers]\n【她現在】 ≤ 8 lines: 在做 · 心情 · 心裡 · 表現 · 對他 · 掛念 · 轉變 · 原則" {class: ours}
  clock: "現在：2026/10/14（二）22:40 — first line of the block, from the engine's clock" {class: proposed}
  thought: "想法：… — one optional line, only when this turn differs from her trait\n(five thinking meters + the moment; dial 4 from the emotion side)" {class: proposed}
  text -> memory -> state
  triggers -> memory: "adds" {style.stroke-dash: 4; style.stroke: "#c2185b"}
  clock -> state: "top" {style.stroke-dash: 4; style.stroke: "#c2185b"}
  thought -> state: "bottom" {style.stroke-dash: 4; style.stroke: "#c2185b"}
}

model: "the model (shim lane auto/556)" {shape: hexagon}

reply: "her reply" {
  scratch: "hidden scratch before the words: 2–3 lines in <think>\ndial 1 sets the medium, dial 6 the order\nstripped at storage; never in history, app, Telegram or the observe" {class: proposed}
  visible: "visible text → transform_llm_output checks (record only) → shim tool-call parser → app / Telegram / voice" {class: ours}
  scratch -> visible: "conditions" {style.stroke-dash: 4; style.stroke: "#c2185b"}
}

homes: "the three homes by cost (design)" {
  h1: "tier 1 · system prompt · ×1 cached\nSOUL (2,500–4,000 chars) + pinned groups (~1,000) + memory rule + date\n\"must shape every reply\" lives here" {class: proposed}
  h2: "tier 2 · per turn, tiny\nstate block + clock (+ 想法 when it differs)\nonly what changes minute by minute" {class: proposed}
  h3: "tier 3 · per turn, only when it hits\nsimilarity recall top 5 + 5, keyword triggers\n\"matters only when the topic comes up\"" {class: proposed}
}

system -> history -> last -> model -> reply
homes.h1 -> system.volatile.pinned {style.stroke-dash: 4; style.stroke: "#c2185b"}
homes.h2 -> last.state {style.stroke-dash: 4; style.stroke: "#c2185b"}
homes.h3 -> last.memory {style.stroke-dash: 4; style.stroke: "#c2185b"}
