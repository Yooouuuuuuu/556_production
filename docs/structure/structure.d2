direction: down

title: "556 Production — structure (0.10.0): one process per character, the inner life inside it, 556d around it; the package is the character" {
  shape: text
  near: top-center
  style.font-size: 20
}

classes: {
  proposed: {
    style.stroke-dash: 4
    style.stroke: "#c2185b"
    style.font-color: "#c2185b"
  }
  external: {
    style.fill: "#f3f3f3"
    style.stroke: "#999999"
  }
  file: {
    shape: page
  }
  package: {
    style.fill: "#fff8e1"
    style.stroke: "#f9a825"
  }
}

legend: |md
  solid = runs today (0.10.0) · **dashed pink** = later · **yellow** = the character package (characters/ID/, authored + generated; copied into her profile before every start)
| {near: top-left}

you: "你 — the person (named in 設定 → 全域; else each character's own default term)" {shape: person}

app: "556 Production app (Electron)" {
  office: "office window" {
    chat: "聊天 — the one conversation, source badges"
    roster: "名單 — start / stop / switch"
    memory: "記憶 — long layer; toggle 近期紀錄"
    settings: "設定 — 全域 (你 · 程式 · 模型連線 (0.9.0) · 語音連線 · backend knobs) / 角色 (list → a character's page:\n基本 · 記憶 · 能力 · 主動 · 聲音 · 頻道 · config knobs; opening it puts her on stage) · 新角色 (the soul skill on a page, 0.8.1)"
    state: "狀態 — timeline, why, loops (incl. 要問誰 / 問到了 / 忘了), relationships, ledger, 沒說出口 (0.5.0+)"
    notes: "system notes — narrator cues, undelivered messages, backend errors: gray, hidden unless 程式 shows them (0.7.4)"
  }
  avatar: "avatar window (Live2D) — follows the chat window; hidden by default (0.8.6)"
}

pkg: "characters/<id>/ — the character package = the character (ignored by git)" {
  class: package
  in: "describe/01…10.md · profile.json — what the author writes" {class: file}
  skill: "tools/soul_writer.py — the soul skill (設定 → 角色 → 新角色 runs it as a 556d job; the simple path needs no model)" {shape: hexagon}
  out: "SOUL.md (時間線 · 影響過你的人與事 inside) · seeds.jsonl · people/*.md · psyche.json · soul.lock.json · build/" {class: file}
  in -> skill -> out
}

daemon: "556d (Go, :55600) — hub around her, never inside, never a chat participant" {
  hub: "hub API + /ws events"
  conn: "model connections (0.9.0) — home/models.json, 設定 → 全域 → 模型連線:\n對話 / 記憶 / 寫靈魂 endpoints, the vectors, the timezone; nothing has a default, nothing starts while something is missing"
  prep: "before every start (prepareProfile) — package sync: SOUL.md · psyche.json · people/*.md copied from characters/<id>/ (你.md only when missing);\nconfig.yaml (model → shim, memory → kokoro, plugins [psyche], empty toolsets) · kokoro.json (llm, embedder) · psyche.json (zone) written from the connections;\nhygiene switches + zh-TW platform hints (0.8.4 / 0.9.0 / 0.10.0)"
  mgr: "companions manager — start (opens her ONE session) / stop (graceful)"
  transcript: "Transcript — her state.db, read-only; a failed turn's dangling user row is deactivated (active=0) (0.7.4)"
  follower: "follower — new rows (Telegram, event turns tagged cue / event) -> windows (2 s poll)"
  mirror: "Telegram send — app turns and her event turns -> DM, plain text, no LLM"
  relay: "relay (0.7.0) + mailbox (0.7.5) — characters talk to each other: a session per pair in each state.db,\none exchange at a time, turn cap; a message for a character who is not running waits in home/mailbox and is delivered at her start"
  memapi: "memory page API — her store, delete via command queue"
  psyapi: "狀態 page API — her psyche.db, read-only (0.5.0+)"
  tools: "tools API — no tools at baseline (0.8.6: memory is injected, not a tool) + extensions per character (restart applies)"
  voice: "voice — global connectors (home/voice.json) with a per-character override (profile voice.json); speak / transcribe use the effective one for the character on stage (0.7.4)"
  sup: "supervisor — job object, planned-stop marker"
  shim: "model shim :55601 — one lane auto/556 → the 對話 connection (bearer key); drops Hermes's vendor paragraphs,\nunwraps the proxy's reply function, strips the hidden <think> scratch; 503 until configured"
  embedder: "embedder — llama-server on the port in models.json, started by 556d only when the vectors are local; else an embeddings endpoint"
}

mane: "a character — ONE process: hermes gateway run (HERMES_HOME = home/profiles/<id>)" {
  api: "API server platform\n/v1/chat/completions · /api/sessions"
  tg: "Telegram adapter — her own bot"
  dc: "Discord adapter (later)" {class: proposed}
  mcp: "MCP bindings (later, strictly hers)" {class: proposed}
  agent: "AIAgent — SOUL (時間線 inside) + kokoro's zh-TW section in the system prompt; memory block + 【她現在】 on the last message;\ntoolsets for this platform (none at baseline), compression"
  kokoro: "kokoro plugin (MemoryProvider) — prefetch (facts · notes · By name) · observe · prompt section 記憶規則 + 關於你"
  psyche: "psyche plugin — THE engine: 1-min tick, A queue, impact model B,\nstate block (the clock first, one optional 想法 line), event turns, loops (promises, asking others, forgetting), the withheld register; single writer of psyche.db"
  state: "state.db — THE one session + its messages = HISTORY" {class: file}
  store: "memory/<id>.db — KeepsakeDB = MEMORY\nlong (facts, subject 你) · short (dated notes) · the seeds" {class: file}
  psydb: "psyche.db — events · appraisals · instances · loops · withheld · snapshots · params (0.5.0+)" {class: file}
  cfg: "SOUL.md · psyche.json · people/*.md (from the package) · config.yaml · kokoro.json (written by 556d) · voice.json (override) · .env" {class: file}
}

telegram: "Telegram servers" {class: external}
llm: "the configured model endpoints — any OpenAI-compatible server (對話 · 記憶; embeddings when not local)" {class: external}

you -> app.office.chat: "types / speaks"
you -> telegram: "DM to her bot"
app.office -> daemon.hub: "HTTP + WebSocket"
app.avatar -> daemon.hub: "/ws bubbles · speak_audio"
daemon.hub -> pkg: "新角色: describe · profile · run · simple · install (api/characters.go)"
pkg.out -> daemon.prep: "copied before every start"
daemon.conn -> daemon.prep
daemon.conn -> daemon.shim: "the 對話 endpoint + key"
daemon.conn -> daemon.embedder: "exe · GGUF · port (kind llama)"
daemon.prep -> mane.cfg: "SOUL.md · psyche.json · people/ · config.yaml · kokoro.json"
daemon.prep -> daemon.mgr: "complete → spawn; missing → the start is refused"
daemon.hub -> mane.api: "one non-stream request per turn\nX-Hermes-Session-Id = her conversation"
telegram -> mane.tg: "polling"
mane.api -> mane.agent
mane.tg -> mane.agent
mane.dc -> mane.agent {class: proposed}
mane.mcp -> mane.agent {class: proposed}
mane.agent -> mane.state: "load history · append the turn"
mane.agent -> mane.kokoro: "prefetch · sync_turn"
mane.kokoro -> mane.store: "search · observe"
mane.kokoro -> daemon.embedder: "embeddings"
mane.agent -> mane.psyche: "after the reply: appraisal A (parallel to observe)"
mane.psyche -> mane.psydb: "events · appraisals · snapshots"
mane.psyche -> mane.agent: "prefetch: 【她現在】 state block, never waits"
mane.psyche -> mane.api: "event turn (X-556-Event) into her one conversation (0.6.0)"
mane.agent -> daemon.shim: "chat completions (reply · observe · A)"
daemon.shim -> llm
daemon.embedder -> llm: "when the vectors come from an endpoint" {style.stroke-dash: 3}
daemon.transcript -> mane.state: "read-only: history, live tail;\nat start: open + stamp her one session if none is live"
daemon.follower -> daemon.hub: "Telegram turns and event turns as chat events (badge)"
daemon.mirror -> telegram: "sendMessage"
daemon.memapi -> mane.store: "read-only + delete commands"
daemon.psyapi -> mane.psydb: "read-only"
daemon.tools -> mane.cfg: "platform_toolsets (extensions only)"
daemon.psyapi -> pkg.out: "主動 sliders write the package's psyche.json too"
daemon.mgr -> daemon.sup: "spawn · planned stop"
daemon.sup -> mane: "process"
daemon.relay -> mane.api: "the other character's words, as a user turn in her session with them"
mane.psyche -> daemon.relay: "her event turn for another character (POST /api/relay)"
