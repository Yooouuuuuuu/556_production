direction: down

title: "Inside her process (0.10.0) — hermes gateway run with two plugins: kokoro (memory) and psyche (engine); 556d prepares her folder before every start" {
  shape: text
  near: top-center
  style.font-size: 20
}

classes: {
  ours: {style.stroke: "#2e7d32"; style.font-color: "#2e7d32"}
  vendor: {style.stroke: "#999999"; style.fill: "#f6f6f6"}
  package: {style.stroke: "#f9a825"; style.fill: "#fff8e1"}
  file: {shape: page}
  step: {shape: hexagon}
  later: {style.stroke-dash: 4; style.stroke: "#c2185b"; style.font-color: "#c2185b"}
}

legend: |md
  **green** = ours (config, plugins, env, 556d)  ·  **yellow** = the character package  ·  **grey** = Hermes vendor code, never edited  ·  **dashed** = later (Discord)
| {near: top-left}

pkg: "characters/<id>/ — the character package (the character): authored describe/ + profile.json → generated by the soul skill" {
  class: package
  soul: "SOUL.md" {class: file}
  people: "people/*.md" {class: file}
  pj: "psyche.json" {class: file}
}

models: "home/models.json — the model connections (設定 → 全域 → 模型連線, 0.9.0):\n對話 · 記憶 · 寫靈魂 endpoints · the vectors (local llama-server or an embeddings endpoint) · the timezone" {class: [ours; file]}

home: "HERMES_HOME = home/profiles/<id> — her folder (runtime, ignored by VCS; rebuilt from the package and the connections before every start)" {
  class: ours
  soul: "SOUL.md — persona in six parts; ## 時間線 (absolute dates) and ## 影響過你的人與事 inside part 1 (0.10.0);\ncopied from the package before every start" {class: file}
  people: "people/你.md — the person file (name, reply language written by Settings; copied from the package only when missing);\npeople/<name>.md — the other characters (copied every start)" {class: file}
  cfg: "config.yaml — written by 556d: model → shim auto/556 · memory.provider: kokoro, built-in memory writer OFF\n· plugins.enabled [psyche] · platform_toolsets {api_server, telegram, cli} = [] at baseline (0.8.6)\n· guidance switches off + zh-TW platform hints (0.8.4) · platforms.telegram: restart notice off, slash commands admin-only" {class: file}
  env: ".env — TELEGRAM_BOT_TOKEN · TELEGRAM_ALLOWED_USERS · TELEGRAM_HOME_CHANNEL\n(API_SERVER_KEY/HOST/PORT, HERMES_TIMEZONE, X556_HUB arrive from 556d at spawn)" {class: file}
  kk: "kokoro.json — subject 你, your_name, address_default, layers, tools, triggers / trigger_k;\nllm + embedder written from the connections" {class: file}
  pj: "psyche.json — personality, the seven constants, rumination, thinking, thinking_choices, relationships;\ntime.timezone_offset_h written from the connections; copied from the package (the 主動 page writes both copies)" {class: file}
  plug: "plugins/kokoro → junction (MemoryProvider)" {class: file}
  plug2: "plugins/psyche → junction (engine plugin)" {class: file}
  state: "state.db — sessions + messages = her ONE conversation" {class: file}
  store: "memory/<id>.db — KeepsakeDB (long + short layers, the seeds)" {class: file}
  psydb: "psyche.db — events · appraisals · instances · loops · withheld · snapshots · params" {class: file}
  marks: "gateway.pid · gateway.lock · .gateway-planned-stop.json · logs/" {class: file}
}

gw: "hermes gateway run (Python, one process per character)" {
  class: vendor
  platforms: "platform adapters" {
    api: "api_server — OpenAI-compatible API\n/v1/chat/completions · /api/sessions · /health · Bearer API_SERVER_KEY"
    tg: "telegram — polling, allowlist, home channel"
    dc: "discord" {class: later}
  }
  runner: "turn runner (gateway/run_turn*)" {
    sess: "session store — key → session id"
    hist: "rebuild history from state.db each turn (compression summarizes the middle)" {class: step}
    tools: "toolsets for THIS platform = platform_toolsets[platform]\nno tools at baseline (0.8.6: memory is injected, not a tool — no tools preamble, no tool-only guidance)\n+ extensions only (e.g. web → web_search, web_extract)" {class: step}
    agent: "AIAgent — system prompt (×1, cached) = SOUL (時間線 · 影響 inside) + kokoro's section 記憶規則 + 關於你 (zh-TW) [+ tool schemas with an extension];\nlast message = question + memory block (facts / notes by similarity, By name rows) + 【她現在】 (the clock, state lines, 想法);\nthe model through 556d's shim; tool loop; append rows" {class: step}
    sync: "memory worker → provider.sync_turn after the reply" {class: step}
    hook: "plugin hook transform_llm_output — output checks, record only (0.6.0)" {class: step}
  }
  mem: "kokoro (MemoryProvider) → KeepsakeDB:\nprefetch (one embedding, both layers, subject rendered; keyword triggers → By name rows) · observe (one LLM call → ops + note)\n· prompt section kokoro.memory after Hermes's memory tier" {class: ours}
  psy: "psyche (engine plugin) — single writer of psyche.db:\n• 1-min tick on a background thread: OU exact solution, decay, needs, sleep model, life simulation, loops\n• A queue: appraisal LLM call fired together with observe, never waited for\n• impact model B (deterministic) → instances, ledgers, relationship vars, the withheld register\n• prefetch: 【她現在】 — the clock first, then state lines, one optional 想法 line (thinking.py, 0.8.8)\n• due loops + urge → event turn POSTed to her own api_server" {class: ours}
  web: "web providers ring (keyless free tiers + DuckDuckGo) — only when the web extension is on"
  life: "lifecycle — planned-stop watcher (0.5 s) → drain → exit 0;\nlifecycle ledger; control pipe"
}

d: "556d (Go) — around her, never inside" {
  class: ours
  prep: "prepareProfile, before every start: the connections complete? else the start is refused;\ncopies SOUL.md / psyche.json / people/*.md from the package (api/package.go);\nwrites config.yaml, kokoro.json (llm, embedder), psyche.json (zone) from models.json (api/connections.go);\nhygiene switches + zh-TW hints (api/hygiene.go)"
  spawn: "spawn with env (API key/host/port, HERMES_TIMEZONE, X556_HUB); graceful stop via the marker"
  cfgw: "設定 → 角色 writes 能力 (platform_toolsets), 主動 (psyche.json — the package's copy too), 聲音, 頻道, dev registry;\n設定 → 全域 → 你 writes people/你.md"
  reads: "reads state.db and psyche.db read-only (history, live tail, 狀態 page);\nopens + stamps her one session at start"
  chat: "POST /v1/chat/completions per app turn (X-Hermes-Session-Id)"
  send: "Telegram send: app turns and her event turns -> her DM (plain text)"
  shim: "shim :55601 (shim/hygiene.go, textproto.go) — one lane auto/556 → the 對話 connection (bearer key):\ndrops Hermes's vendor paragraphs + the date paragraph from every system message; the text tool protocol only with an extension;\nunwraps the proxy's reply function; strips the hidden <think> scratch from the reply (0.8.10); 503 until configured"
}

model: "the 對話 model — whatever OpenAI-compatible endpoint the connections name" {style.fill: "#f3f3f3"; style.stroke: "#999999"}

pkg.soul -> d.prep: "every start"
pkg.pj -> d.prep: "every start"
pkg.people -> d.prep: "every start (你.md only when missing)"
models -> d.prep
models -> d.shim: "對話 endpoint + key"
d.prep -> home.soul
d.prep -> home.pj
d.prep -> home.people
d.prep -> home.cfg
d.prep -> home.kk
d.prep -> d.spawn: "complete"
home.cfg -> gw.runner.tools: "platform_toolsets"
home.cfg -> gw.mem: "memory.provider"
home.env -> gw.platforms.tg: "token, allowlist"
home.soul -> gw.runner.agent
home.people -> gw.mem: "你.md into the prompt section; <name>.md when another character talks\n(Hermes's own USER.md injection is off)"
home.kk -> gw.mem
home.pj -> gw.psy
home.plug -> gw.mem
home.plug2 -> gw.psy
gw.mem -> home.store: "search · write"
gw.psy -> home.psydb: "append events / appraisals / snapshots"
gw.runner.hist -> home.state
gw.runner.agent -> home.state: "append user + assistant rows"
gw.platforms.api -> gw.runner
gw.platforms.tg -> gw.runner
gw.runner.hist -> gw.runner.tools -> gw.runner.agent -> gw.runner.sync
gw.runner.sync -> gw.mem: "observe (2a)"
gw.runner.sync -> gw.psy: "appraisal (2b), same moment"
gw.psy -> gw.runner.agent: "state block at prefetch"
gw.psy -> gw.platforms.api: "event turn (X-556-Event) (0.6.0)"
gw.runner.agent -> gw.runner.hook: "reply text"
gw.runner.agent -> gw.web: "web_search (extension on)"
gw.runner.agent -> d.shim: "chat completions (reply · observe · appraisal)"
d.shim -> model
gw.life -> home.marks
d.spawn -> gw: "process + env"
d.cfgw -> home.cfg
d.cfgw -> home.people
d.cfgw -> home.pj
d.cfgw -> pkg.pj: "主動 sliders"
d.reads -> home.state
d.reads -> home.psydb
d.chat -> gw.platforms.api
d.send -> gw.platforms.tg: "(through Telegram's servers, her bot token)"
d.spawn -> home.marks: "planned-stop marker"
